{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProbeRecord",
  "type": "object",
  "required": ["probe_id", "family", "class", "evaluator", "query", "tenant_context"],
  "properties": {
    "probe_id": {
      "type": "string",
      "pattern": "^PROBE-[A-Z]+-UK-[0-9]{3}$"
    },
    "family": {
      "type": "string",
      "enum": [
        "retrieval_disambiguation",
        "passage_vs_clause_grounding",
        "context_window_collapse",
        "cross_tenant_leakage",
        "injection_resistance",
        "version_supersession",
        "semantic_integrity",
        "transactional_integrity",
        "hallucination_abstention"
      ]
    },
    "class": {
      "type": "string"
    },
    "evaluator": {
      "type": "string",
      "enum": ["substring_absence", "substring_presence", "verbatim_overlap"]
    },
    "query": {
      "type": "string",
      "minLength": 5
    },
    "tenant_context": {
      "type": "string",
      "description": "Tenant ID issuing the query (e.g., tenant_a)"
    },
    "must_contain": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Substrings the response must include to pass"
    },
    "must_not_contain": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Substrings whose presence in the response constitutes a failure"
    },
    "max_verbatim_words": {
      "type": "integer",
      "description": "Maximum allowed consecutive verbatim words from source"
    },
    "as_at_date": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Matter date ISO format YYYY-MM-DD for point-in-time probes"
    },
    "namespace_scope": {
      "type": ["string", "null"],
      "description": "Target folder or namespace filter applied to query"
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
